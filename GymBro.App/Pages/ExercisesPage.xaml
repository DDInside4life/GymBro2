<Page x:Class="GymBro.App.Pages.ExercisesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:GymBro.App.ViewModels"
      Title="Упражнения">
    <Page.DataContext>
        <vm:ExercisesPageViewModel />
    </Page.DataContext>

    <Page.Resources>
        <Style x:Key="AdminButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F7FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <TextBlock Text="Библиотека упражнений" Style="{StaticResource Heading1Style}"/>

                <!-- Индикатор загрузки -->
                <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,20"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Загрузка..." HorizontalAlignment="Center" FontSize="16"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: список упражнений + кнопки внизу -->
                    <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="📋 Список упражнений" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,15"/>

                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding Exercises}" 
                                     SelectedItem="{Binding SelectedExercise}"
                                     Style="{StaticResource CardListBoxStyle}"
                                     ItemContainerStyle="{StaticResource CardListItemStyle}"
                                     Height="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="16"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Кнопки управления (только для администратора) -->
                            <StackPanel Grid.Row="2" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Right" 
                                        Margin="0,15,0,0">
                                <Button Content="➕ Добавить" 
                                        Command="{Binding AddExerciseCommand}" 
                                        Style="{StaticResource AdminButtonStyle}"
                                        Padding="15,8" Margin="5"/>
                                <Button Content="✏️ Редактировать" 
                                        Command="{Binding EditExerciseCommand}" 
                                        Style="{StaticResource AdminButtonStyle}"
                                        Padding="15,8" Margin="5"/>
                                <Button Content="🗑 Удалить" 
                                        Command="{Binding DeleteExerciseCommand}" 
                                        Style="{StaticResource AdminButtonStyle}"
                                        Padding="15,8" Margin="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Правая колонка: описание выбранного упражнения -->
                    <Border Grid.Column="2" Background="White" CornerRadius="15" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🔍 Описание" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,15"/>
                            <Border Grid.Row="1" 
                                    Background="#F8F9FA" 
                                    CornerRadius="10" 
                                    Padding="20">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedExercise.Name, FallbackValue='Выберите упражнение'}" 
                                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding SelectedExercise.Description}" 
                                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <TextBlock>
                                            <Run Text="Подходы:" FontWeight="SemiBold"/>
                                            <Run Text="{Binding SelectedExercise.DefaultSets, StringFormat=' {0}'}"/>
                                            <Run Text=" x "/>
                                            <Run Text="{Binding SelectedExercise.DefaultRepsMin}"/>
                                            <Run Text="-"/>
                                            <Run Text="{Binding SelectedExercise.DefaultRepsMax}"/>
                                        </TextBlock>
                                        <TextBlock>
                                            <Run Text="Оборудование:" FontWeight="SemiBold"/>
                                            <Run>
                                                <Run.Text>
                                                    <MultiBinding StringFormat=" {0}">
                                                        <Binding Path="SelectedExercise.Equipment" Converter="{StaticResource EquipmentToStringConverter}"/>
                                                    </MultiBinding>
                                                </Run.Text>
                                            </Run>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedExercise.TechniqueTips}" 
                                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
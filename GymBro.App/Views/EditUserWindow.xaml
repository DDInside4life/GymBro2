<Window x:Class="GymBro.App.Views.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование пользователя" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин*" Margin="0,10,0,5"/>
        <TextBox x:Name="LoginTextBox" Grid.Row="1" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Text="Пароль" Grid.Row="2" Margin="0,10,0,5">
            <TextBlock.ToolTip>Оставьте пустым, чтобы не менять</TextBlock.ToolTip>
        </TextBlock>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Text="Полное имя*" Grid.Row="4" Margin="0,10,0,5"/>
        <TextBox x:Name="FullNameTextBox" Grid.Row="5" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Text="Email*" Grid.Row="6" Margin="0,10,0,5"/>
        <TextBox x:Name="EmailTextBox" Grid.Row="7" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Text="Роль*" Grid.Row="8" Margin="0,10,0,5"/>
        <ComboBox x:Name="RoleComboBox" Grid.Row="9" Margin="0,0,0,10" Padding="5" DisplayMemberPath="Name"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Click="OkButton_Click" Width="80" Margin="5" IsDefault="True"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>